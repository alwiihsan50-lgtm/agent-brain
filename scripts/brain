#!/usr/bin/env python3
import sys
import os
import re
import socket
import subprocess
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor

BRAIN_DIR = "/home/cuker/agent-brain"
README_PATH = os.path.join(BRAIN_DIR, "README.md")
SESSION_PATH = os.path.join(BRAIN_DIR, "ACTIVE_SESSION.md")
ARCHIVE_PATH = os.path.join(BRAIN_DIR, "docs/history/completed-milestones-archive.md")

PORTS_CONFIG = [
    {"name": "STB Remote Hub", "host": "127.0.0.1", "port": 8080, "desc": "Port 8080 (Hub)"},
    {"name": "MT5 Acc 1 (SMC)", "host": "127.0.0.1", "port": 3000, "desc": "Port 3000"},
    {"name": "MT5 Acc 2 (Martingale)", "host": "127.0.0.1", "port": 3002, "desc": "Port 3002"},
    {"name": "TailShare (Original)", "host": "127.0.0.1", "port": 40506, "desc": "Port 40506"},
    {"name": "TailShare (Clean)", "host": "127.0.0.1", "port": 40507, "desc": "Port 40507"},
    {"name": "AI Photo Eraser (Web)", "host": "127.0.0.1", "port": 3005, "desc": "Port 3005"},
    {"name": "AI Photo Eraser (API)", "host": "127.0.0.1", "port": 3003, "desc": "Port 3003"},
    {"name": "9Router AI Gateway", "host": "127.0.0.1", "port": 20128, "desc": "Port 20128"},
    {"name": "Headroom Compressor", "host": "127.0.0.1", "port": 8787, "desc": "Port 8787"},
    {"name": "MoneyPrinter API", "host": "127.0.0.1", "port": 8095, "desc": "Port 8095"},
    {"name": "MoneyPrinter WebUI", "host": "127.0.0.1", "port": 8501, "desc": "Port 8501"},
    {"name": "PC Torrent (Aria2)", "host": "127.0.0.1", "port": 6801, "desc": "Port 6801"},
    {"name": "PC Torrent (Web UI)", "host": "127.0.0.1", "port": 6888, "desc": "Port 6888"},
